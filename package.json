{
  "name": "snapboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:render": "playwright test --config=tests/render/playwright.config.ts",
    "e2e": "playwright test",
    "spike": "playwright test --config=spikes/playwright.config.ts",
    "verify": "npm run typecheck && npm run test && npm run test:render && npm run e2e"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15",
    "immer": "^11.1.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "happy-dom": "^20.14.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
